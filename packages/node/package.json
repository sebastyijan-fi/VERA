{
    "name": "@vera/node",
    "version": "1.0.0",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "vera": "./dist/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsup src/index.ts src/cli.ts --tsconfig tsconfig.build.json --dts --format esm",
        "dev": "tsup src/index.ts src/cli.ts --watch --dts --format esm",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sebastyijan-fi/VERA.git",
        "directory": "packages/node"
    },
    "dependencies": {
        "@iarna/toml": "^2.2.5",
        "@vera/core": "workspace:*",
        "@vera/dsl": "workspace:*",
        "@vera/engine": "workspace:*",
        "@vera/net": "workspace:*",
        "@vera/store": "workspace:*",
        "commander": "^11.0.0",
        "consola": "^3.2.0",
        "picocolors": "^1.1.1"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@vitest/coverage-v8": "3.2.4",
        "tsup": "^8.0.0",
        "typescript": "^5.0.0",
        "vitest": "^3.0.0"
    },
    "keywords": [
        "vera",
        "node",
        "validator",
        "blockchain"
    ],
    "license": "AGPL-3.0-only"
}