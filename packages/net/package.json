{
    "name": "@vera/net",
    "version": "1.0.0",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsup src/index.ts --tsconfig tsconfig.build.json --dts --format esm",
        "dev": "tsup src/index.ts --watch --dts --format esm",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sebastyijan-fi/VERA.git",
        "directory": "packages/net"
    },
    "dependencies": {
        "@vera/core": "workspace:*",
        "cbor-x": "^1.6.0",
        "eventemitter3": "^5.0.0"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@vitest/coverage-v8": "3.2.4",
        "tsup": "^8.0.0",
        "typescript": "^5.0.0",
        "vitest": "^3.0.0"
    },
    "keywords": [
        "vera",
        "p2p",
        "networking",
        "cbor",
        "blockchain"
    ],
    "license": "AGPL-3.0-only"
}