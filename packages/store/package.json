{
    "name": "@vera/store",
    "version": "0.1.0",
    "type": "module",
    "description": "VERA Data Persistence Layer",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts": {
        "build": "tsup src/index.ts --tsconfig tsconfig.build.json --dts --format esm",
        "dev": "tsup src/index.ts --watch --dts --format esm",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint src",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@vera/core": "workspace:*",
        "cbor-x": "^1.6.0",
        "classic-level": "^3.0.0"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@vitest/coverage-v8": "^3.2.4",
        "tsup": "^8.0.0",
        "typescript": "^5.3.0",
        "vitest": "^3.0.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sebastyijan-fi/VERA.git",
        "directory": "packages/store"
    },
    "keywords": [
        "vera",
        "storage",
        "leveldb",
        "persistence",
        "blockchain"
    ],
    "license": "AGPL-3.0-only",
    "files": [
        "dist",
        "src"
    ]
}