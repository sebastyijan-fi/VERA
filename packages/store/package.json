{
    "name": "@vera/store",
    "version": "0.1.0",
    "type": "module",
    "description": "VERA Data Persistence Layer",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts": {
        "build": "tsup --tsconfig tsconfig.build.json",
        "dev": "tsup --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint src",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@vera/core": "workspace:*",
        "cbor-x": "^1.6.0",
        "classic-level": "^3.0.0"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "tsup": "^8.0.0",
        "typescript": "^5.3.0",
        "vitest": "^3.0.0"
    },
    "files": [
        "dist",
        "src"
    ]
}