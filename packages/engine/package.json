{
    "name": "@vera/engine",
    "version": "0.1.0",
    "type": "module",
    "description": "VERA Transaction State Processor (TSP)",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./vm": {
            "import": "./dist/vm/index.js",
            "types": "./dist/vm/index.d.ts"
        },
        "./gas": {
            "import": "./dist/gas/index.js",
            "types": "./dist/gas/index.d.ts"
        },
        "./state": {
            "import": "./dist/state/index.js",
            "types": "./dist/state/index.d.ts"
        }
    },
    "scripts": {
        "build": "tsup src/index.ts src/parallel/worker.ts --tsconfig tsconfig.build.json --dts --format esm",
        "dev": "tsup src/index.ts src/parallel/worker.ts --watch --dts --format esm",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint src",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@vera/core": "workspace:*",
        "@vera/dsl": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^25.0.10",
        "@vitest/coverage-v8": "3.2.4",
        "tsup": "^8.0.0",
        "typescript": "^5.3.0",
        "vitest": "^3.0.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sebastyijan-fi/VERA.git",
        "directory": "packages/engine"
    },
    "keywords": [
        "vera",
        "vm",
        "deterministic",
        "execution",
        "merkle",
        "blockchain"
    ],
    "license": "AGPL-3.0-only",
    "files": [
        "dist",
        "src"
    ]
}