{
    "name": "@vera/core",
    "version": "0.1.0",
    "description": "VERA core types, cryptographic primitives, and state management",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./types": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/types/index.js"
        },
        "./crypto": {
            "types": "./dist/crypto/index.d.ts",
            "import": "./dist/crypto/index.js"
        },
        "./encoding": {
            "types": "./dist/encoding/index.d.ts",
            "import": "./dist/encoding/index.js"
        },
        "./state": {
            "types": "./dist/state/index.d.ts",
            "import": "./dist/state/index.js"
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsup src/index.ts src/crypto/worker.ts --tsconfig tsconfig.build.json --dts --format esm",
        "dev": "tsup src/index.ts src/crypto/worker.ts --watch --dts --format esm",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "@noble/ed25519": "^2.2.3",
        "@noble/hashes": "^1.7.1",
        "cbor-x": "^1.6.0"
    },
    "devDependencies": {
        "@types/node": "^22.10.7",
        "@vitest/coverage-v8": "3.2.4",
        "tsup": "^8.3.5",
        "typescript": "^5.7.3",
        "vitest": "^3.0.4"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sebastyijan-fi/VERA.git",
        "directory": "packages/core"
    },
    "keywords": [
        "vera",
        "verifiable",
        "execution",
        "registry",
        "cryptography",
        "blockchain"
    ],
    "license": "AGPL-3.0-only"
}