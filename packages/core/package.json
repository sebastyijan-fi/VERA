{
    "name": "@vera/core",
    "version": "0.1.0",
    "description": "VERA core types, cryptographic primitives, and state management",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./types": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/types/index.js"
        },
        "./crypto": {
            "types": "./dist/crypto/index.d.ts",
            "import": "./dist/crypto/index.js"
        },
        "./encoding": {
            "types": "./dist/encoding/index.d.ts",
            "import": "./dist/encoding/index.js"
        },
        "./state": {
            "types": "./dist/state/index.d.ts",
            "import": "./dist/state/index.js"
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "@noble/hashes": "^1.7.1",
        "@noble/ed25519": "^2.2.3",
        "cbor-x": "^1.6.0"
    },
    "devDependencies": {
        "@types/node": "^22.10.7",
        "tsup": "^8.3.5",
        "typescript": "^5.7.3",
        "vitest": "^3.0.4"
    },
    "keywords": [
        "vera",
        "verifiable",
        "cryptography",
        "merkle",
        "state"
    ],
    "license": "Apache-2.0"
}