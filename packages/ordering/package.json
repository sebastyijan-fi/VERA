{
    "name": "@vera/ordering",
    "version": "0.1.0",
    "type": "module",
    "description": "VERA Transaction Ordering Layer",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts": {
        "build": "tsup --tsconfig tsconfig.build.json",
        "dev": "tsup --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint src",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@vera/core": "workspace:*",
        "@vera/store": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@vitest/coverage-v8": "3.2.4",
        "tsup": "^8.0.0",
        "typescript": "^5.3.0",
        "vitest": "^3.0.0"
    },
    "files": [
        "dist",
        "src"
    ]
}