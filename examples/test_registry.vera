module TestRegistry;

entity Balance[address] {
    value: UInt
}

transaction Deposit(acc: address, amount: UInt) {
    require amount > 0;
    
    let current = get<Balance>(acc);
    if (current == null) {
        set get<Balance>(acc) = Balance { value: amount };
    } else {
        set get<Balance>(acc) = Balance { value: current.value + amount };
    }
}
